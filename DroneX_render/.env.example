# Copy to .env.local (gitignored) in this folder. Server-side only: nothing here reaches the browser.
# The live layer (DroneX_live) and the agents (DroneX_agents) read this same file.

# Where the simulation engine keeps daemon.json and its unix socket (dev.sh sets this; default is the sibling checkout).
# DRONEX_CORE_DATA_DIR=../dronex/DroneX_1/.dev/core-data

# Intent model for the copilot and the Dispatch agent: any OpenAI-compatible chat-completions endpoint.
# ASI:One (Fetch.ai) by default; get a key at https://asi1.ai/dashboard/api-keys
INTENT_API_BASE=https://api.asi1.ai/v1
INTENT_API_KEY=
INTENT_MODEL=asi1-mini

# Cartesia: https://play.cartesia.ai (API keys). Voices: pick ids from the Voice Library.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2

# SpacetimeDB: local `spacetime start` (ws://127.0.0.1:3100) or Maincloud (wss://maincloud.spacetimedb.com).
SPACETIME_URI=ws://127.0.0.1:3100
SPACETIME_DB=dronex-airspace
# Public URL the browser uses for the same database (usually the same as SPACETIME_URI).
NEXT_PUBLIC_SPACETIME_URI=ws://127.0.0.1:3100
NEXT_PUBLIC_SPACETIME_DB=dronex-airspace

# Elastic Cloud Serverless: the Elasticsearch endpoint and an API key from the project's "API keys" page.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=dronex

# Fetch.ai agents: seeds keep the agent addresses stable between runs (any long random strings).
DRONEX_DISPATCHER_SEED=
DRONEX_FLEET_SEED=
DRONEX_FLIGHT_SEED=
# Where the agents reach the configurator's API.
DRONEX_RENDER_URL=http://localhost:3000
# Agentverse API key (agentverse.ai → Profile → API Keys): lets DroneX_agents/scripts/connect_agentverse.py connect
# the dispatcher's mailbox from the terminal instead of the inspector's Connect button.
AGENTVERSE_API_KEY=
# Payment Protocol bonus: 1 to quote a price per flight; with the ledger flag the dispatcher pays real testnet FET
# (Dorado, fund it from the faucet) and the flight agent checks the transaction on chain before it flies.
# DRONEX_PAYMENTS=0
# DRONEX_PAYMENTS_LEDGER=0
# DRONEX_FLIGHT_PRICE_FET=0.5

# --- Public deployment (deploy/, docs/DEPLOY.md). Leave unset for local development. ---
# On the server this file is a symlink to /etc/dronex/env; deploy/env.example lists every production variable.
# The public URLs and NEXT_PUBLIC_* values are baked in at `next build`: set them before building.
# DRONEX_PUBLIC_URL=https://dronex.example.com
# DRONEX_SIM_UI_URL=https://sim.example.com
# Simulator caps: running DroneX sims at most (below 32, from sizing), idle and maximum age in minutes.
# DRONEX_MAX_SIMS=4
# DRONEX_SIM_IDLE_MIN=10
# DRONEX_SIM_MAX_MIN=30
# Secrets (openssl rand -hex 32): the ownership-cookie HMAC key and the agents' x-dronex-agent token.
# DRONEX_COOKIE_SECRET=
# DRONEX_AGENT_TOKEN=
# SpacetimeDB writer identity for the server side (printed by DroneX_live/scripts/spacetime-add-writer.sh).
# SPACETIME_TOKEN=
# Agents in production: public links, logs to stdout, Dispatch limits.
# DRONEX_LOG_STDOUT=1
# DRONEX_DISPATCH_MAX_ACTIVE=3
# DRONEX_DISPATCH_TTL_MIN=10
# DRONEX_DISPATCH_COOLDOWN_S=60
# DRONEX_DISPATCH_RATE_PER_MIN=10
# DRONEX_DISPATCH_RATE_PER_DAY=100
# DRONEX_DISPATCH_DAILY_MODEL_CALLS=500
# DRONEX_DISPATCH_MAX_INPUT_CHARS=1500
# Mirror: operator name shown to visitors, Maincloud keepalive, restart after failed ticks, Elastic retention.
# MIRROR_OPERATOR=DroneX
# MIRROR_KEEPALIVE_HOURS=
# MIRROR_MAX_TICK_FAILURES=
# ELASTIC_RETENTION=7d
