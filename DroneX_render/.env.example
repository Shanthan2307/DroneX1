# Copy to .env.local (gitignored) in this folder. Server-side only: nothing here reaches the browser.
# The live layer (DroneX_live) and the agents (DroneX_agents) read this same file.

# Where the simulation engine keeps daemon.json and its unix socket (dev.sh sets this; default is the sibling checkout).
# DRONEX_CORE_DATA_DIR=../dronex/DroneX_1/.dev/core-data

# Intent model for the copilot and the Dispatch agent: any OpenAI-compatible chat-completions endpoint.
# ASI:One (Fetch.ai) by default; get a key at https://asi1.ai/dashboard/api-keys
INTENT_API_BASE=https://api.asi1.ai/v1
INTENT_API_KEY=
INTENT_MODEL=asi1-mini

# Cartesia: https://play.cartesia.ai (API keys). Voices: pick ids from the Voice Library.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2

# SpacetimeDB: local `spacetime start` (ws://127.0.0.1:3100) or Maincloud (wss://maincloud.spacetimedb.com).
SPACETIME_URI=ws://127.0.0.1:3100
SPACETIME_DB=dronex-airspace
# Public URL the browser uses for the same database (usually the same as SPACETIME_URI).
NEXT_PUBLIC_SPACETIME_URI=ws://127.0.0.1:3100
NEXT_PUBLIC_SPACETIME_DB=dronex-airspace

# Elastic Cloud Serverless: the Elasticsearch endpoint and an API key from the project's "API keys" page.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=dronex

# Fetch.ai agents: seeds keep the agent addresses stable between runs (any long random strings).
DRONEX_DISPATCHER_SEED=
DRONEX_FLEET_SEED=
DRONEX_FLIGHT_SEED=
# Where the agents reach the configurator's API.
DRONEX_RENDER_URL=http://localhost:3000
