# Copy to .env, or export these before `npm start`.
PORT=45103
HOST=127.0.0.1
DATABASE_PATH=data/backend.db
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# Map keys for the interface (keep each restricted at its provider).
# ArcGIS Location Platform key with basemap access, for the 2D map.
ARCGIS_KEY=
# Google Maps Platform key with the Map Tiles API, for the 3D map.
GOOGLE_MAPS_KEY=
# Flights and recordings (phase 3).
# STORAGE_DIR=data/blobs
# PUBLIC_URL=http://localhost:45103
# STORAGE_QUOTA_GB=10
# Hosted model (phase 4): the agent for signed-in users with no key of their
# own. Without a key its route refuses and Core asks for an own key.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Tokens (in + out) one account may use per UTC day; 0 is no limit.
# MODEL_DAILY_TOKENS=0
# Place search (Places page, map search, the agent's place tools) uses
# ARCGIS_KEY with Esri's geocoder. Saved places keep coordinates, which
# Esri's terms allow only for stored geocodes: give the key the "Geocoding
# (stored)" privilege and set this to true.
# ARCGIS_GEOCODE_FOR_STORAGE=false
# PLACE_SEARCHES_PER_MINUTE=60
