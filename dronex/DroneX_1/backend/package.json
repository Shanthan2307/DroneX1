{
  "name": "dronex-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted account server for Core: the /v1 API described in docs/backend/API.md.",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
