# DroneX production environment: every variable, split into the four files under /etc/dronex/.
#
# deploy/provision.sh writes each "### FILE:" section to its path the first time (it never overwrites a file that
# exists), replacing @DOMAIN@ with your domain and every @HEX32@ / @B64_48@ with a freshly generated secret. Fill
# in the empty values afterwards with `sudo -e /etc/dronex/<file>`.
#
# Format rules (systemd EnvironmentFile, DroneX_live's loadEnv and python-dotenv all read these files):
#   - plain KEY=VALUE lines, no quotes, no `export`;
#   - NO inline comments: `KEY=value # note` makes "value # note" the value. Comments go on their own line.
#   - Never commit a filled-in copy of this file.
#
# Ownership: root:dronex, mode 0640 (provision.sh sets this).

### FILE: /etc/dronex/env
# Shared by the configurator (dronex-render), the mirror (dronex-mirror) and the agents (dronex-agents).
# Symlinked into every release as DroneX_render/.env.local, the path the mirror and the agents read.
# The NEXT_PUBLIC_* values and the two public URLs are baked into the configurator at `next build` time:
# change them, then run deploy/deploy.sh again (a restart is not enough).

# Public addresses. The simulator link on /copilot and /dispatch, and every link the agents send, use these.
DRONEX_PUBLIC_URL=https://dronex.@DOMAIN@
DRONEX_SIM_UI_URL=https://sim.@DOMAIN@
# Core's data folder: daemon.json and the operator-cli unix socket. Mode 700, owned by dronex.
DRONEX_CORE_DATA_DIR=/var/lib/dronex/core
# Where the agents call the configurator API (loopback; never the public URL).
DRONEX_RENDER_URL=http://127.0.0.1:3000

# Shared secret the agents send as `x-dronex-agent` to the agent-only configurator routes.
DRONEX_AGENT_TOKEN=@HEX32@
# HMAC key for the per-visitor vehicle-ownership cookie.
DRONEX_COOKIE_SECRET=@HEX32@

# Simulator caps (configurator). Set DRONEX_MAX_SIMS from sizing (deploy/README.md, "Sizing"); keep it below 32.
DRONEX_MAX_SIMS=4
# Stop sims disarmed longer than this many minutes.
DRONEX_SIM_IDLE_MIN=10
# Stop sims older than this many minutes.
DRONEX_SIM_MAX_MIN=30
# Hangar designs the store reaper keeps (comma-separated design ids), if the configurator supports it.
# DRONEX_PINNED_DESIGNS=

# Intent model (copilot + Dispatch): any OpenAI-compatible endpoint. ASI:One by default. Set a spend limit.
INTENT_API_BASE=https://api.asi1.ai/v1
INTENT_API_KEY=
INTENT_MODEL=asi1-mini

# Cartesia voice (Ask DroneX, /copilot). Set a spend limit.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2

# Elastic Serverless. This is the READ-ONLY key (analytics); the mirror's writer key is in mirror.env.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=dronex

# SpacetimeDB Maincloud (the shared airspace). If the database name is taken, change all four *SPACETIME_DB values.
SPACETIME_URI=wss://maincloud.spacetimedb.com
SPACETIME_DB=dronex-airspace
NEXT_PUBLIC_SPACETIME_URI=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIME_DB=dronex-airspace
# The server-side writer identity, shared by the configurator server and the mirror. Paste the token that
# DroneX_live/scripts/spacetime-add-writer.sh prints (deploy/README.md, "SpacetimeDB"). Without it the mirror falls
# back to SPACETIME_TOKEN_FILE, and an unregistered identity can read but not write.
SPACETIME_TOKEN=
SPACETIME_TOKEN_FILE=/var/lib/dronex/spacetime/server.token
# Shown to every visitor as the airspace operator; without it the server hostname leaks.
MIRROR_OPERATOR=DroneX

# Dispatch agents. Three NEW seeds (never the development defaults); the agents refuse to start with a mailbox
# and a default seed. Changing a seed changes the agent's address: re-register on Agentverse afterwards.
DRONEX_DISPATCHER_SEED=@HEX32@
DRONEX_FLEET_SEED=@HEX32@
DRONEX_FLIGHT_SEED=@HEX32@
DRONEX_MAILBOX=1
DRONEX_PAYMENTS=0
DRONEX_PAYMENTS_LEDGER=0
# Agent logs go to stdout (journald) as well as DroneX_agents/logs.
DRONEX_LOG_STDOUT=1
# Dispatch limits (defaults shown).
# DRONEX_DISPATCH_MAX_ACTIVE=3
# DRONEX_DISPATCH_TTL_MIN=10
# DRONEX_DISPATCH_COOLDOWN_S=60
# DRONEX_DISPATCH_RATE_PER_MIN=10
# DRONEX_DISPATCH_RATE_PER_DAY=100
# DRONEX_DISPATCH_DAILY_MODEL_CALLS=500
# DRONEX_DISPATCH_MAX_INPUT_CHARS=1500
# Only for the one-time DroneX_agents/scripts/connect_agentverse.py run; leave empty otherwise.
AGENTVERSE_API_KEY=
# Leave DRONEX_AGENTS_DIR unset: /api/dispatch reads ../DroneX_agents/logs.

### FILE: /etc/dronex/mirror.env
# Only for dronex-mirror; loaded after /etc/dronex/env, so these values win.
# The Elastic WRITER key (create_index, write, read, manage on dronex-*).
ELASTIC_API_KEY=
MIRROR_OPERATOR=DroneX
# A small keepalive reducer call every this many hours, so Maincloud does not idle-pause the database.
# MIRROR_KEEPALIVE_HOURS=
# Exit (and let systemd restart the mirror) after this many failed ticks in a row.
# MIRROR_MAX_TICK_FAILURES=
# Retention of the dronex-telemetry / dronex-events data streams (applied by `npm run elastic:setup`).
ELASTIC_RETENTION=7d

### FILE: /etc/dronex/backend.env
# The account backend (dronex/DroneX_1/backend). Loopback only; Caddy exposes /v1/maps/* and /v1/places* on sim.
PORT=45103
HOST=127.0.0.1
DATABASE_PATH=/var/lib/dronex/backend.db
PUBLIC_URL=https://sim.@DOMAIN@
SESSION_SECRET=@B64_48@
# Browser keys, handed to the 3D page. Restrict by referrer https://sim.@DOMAIN@/* and by API, with a daily cap.
# ArcGIS: basemap and elevation only.
ARCGIS_KEY=
# Google Maps Platform: Map Tiles API only.
GOOGLE_MAPS_KEY=
# Server-side geocoding (place search, the copilot's goto_place). Geocoding only, restricted to the VM's IP.
ARCGIS_GEOCODE_KEY=
ARCGIS_GEOCODE_FOR_STORAGE=false
# Per client IP (from Caddy's X-Forwarded-For). Core's own calls share one loopback bucket.
PLACE_SEARCHES_PER_MINUTE=30
# Leave the hosted-model keys unset: visitors never sign in.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

### FILE: /etc/dronex/core.env
# The simulation engine (Core, release build). Read by dronex-core.service, which also expands the DRONEX_* values
# below into its command line.
UXDUCK_NO_TRAY=1
UXDUCK_NO_ANALYTICS=1
UXDUCK_INTERFACE_URL=none
UXDUCK_SIM_CATALOGUE_URL=none
UXDUCK_API_URL=http://127.0.0.1:45103
# The public guest listener behind Caddy (sim.@DOMAIN@). The operator listener stays on 127.0.0.1:45010.
DRONEX_SIM_ORIGIN=https://sim.@DOMAIN@
DRONEX_SIM_PUBLIC_PORT=45020
# Engine-side backstop: stop simulator links older than this many minutes (above DRONEX_SIM_MAX_MIN).
DRONEX_SIM_MAX_AGE_MIN=45
